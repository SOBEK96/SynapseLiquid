{
  "name": "synapseliquid-terminal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Financial terminal for the SynapseLiquid on-chain credit protocol (GenLayer Studio Next)",
  "scripts": {
    "sync": "node scripts/sync-deployment.mjs",
    "dev": "npm run sync && vite",
    "build": "npm run sync && tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "console-check": "node scripts/console-check.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "genlayer-js": "2.0.0-rc.1",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "puppeteer-core": "^23.5.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
